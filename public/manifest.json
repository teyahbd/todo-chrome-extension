{
  "manifest_version": 3,
  "name": "Todo List Extension",
  "version": "1.0.0",
  "description": "A React todo list chrome extension that uses Neo-brutalist UI components.",
  "icons": {
    "128": "assets/favicon.png"
  },
  "action": {
    "default_title": "Floating React UI",
    "default_icon": {
      "128": "assets/favicon.png"
    }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bundle.js", "bundle.css", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
